{
    "layer": "top",
    "position": "top",
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["memory", "cpu", "battery", "pulseaudio", "network"],
    
    "hyprland/window": {
        "format": "{}"
    },
    "clock": {
        "format": "{:%H:%M}",
        "timezone": "Europe/London"
    },
    "cpu": {
        "format": " {usage}%"
    },
    "memory": {
        "format": " {used:.1f}GB"
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": " Connected"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": ["", "", ""]
    }
}
