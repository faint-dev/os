# Zog Fast Boot Presets
# Enable ONLY essential services, disable everything else

# Core system (MANDATORY)
enable systemd-timesyncd.service
enable systemd-resolved.service

# Power & thermal (battery life critical)
enable tlp.service
enable thermald.service

# Networking (Wi-Fi, Bluetooth)
enable NetworkManager.service
enable bluetooth.service

# Security
enable ufw.service

# SSD maintenance (periodic TRIM — preferred over the discard mount option)
enable fstrim.timer

# Disable bloat (conflicts, slow startup)
disable power-profiles-daemon.service
disable power-profiles-daemon.socket
disable ModemManager.service
disable ModemManager-wait-for-devices.service
disable avahi-daemon.service
disable avahi-daemon.socket
disable cups.service
disable cups.socket
disable cups-browsed.service
disable bluetooth.socket
disable systemd-networkd.service
disable systemd-networkd.socket
